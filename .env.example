# Change every value before a public deployment. Keep the real .env file private.
APP_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_CODE=replace-admin-code
JUDGE_CODE=replace-judge-code
JURY_CODE=replace-jury-code
STUDENT_CODE=replace-student-code
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
